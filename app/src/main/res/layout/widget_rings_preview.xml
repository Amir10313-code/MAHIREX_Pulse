<?xml version="1.0" encoding="utf-8"?>
<!-- picker preview for Android 12+ (previewLayout); static sample values, same look as the real widget -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_preview_rings_ring" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:maxLines="1"
                android:text="@string/wd_rings_title"
                android:textColor="#FF60A5FA"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/sec_storage"
                android:textColor="#FFF4F5FF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="79.4 / 128 GB"
                android:textColor="#FFC3CAEA"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:textSize="11sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/sec_ram"
                android:textColor="#FFF4F5FF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3.1 / 6 GB"
                android:textColor="#FFC3CAEA"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
